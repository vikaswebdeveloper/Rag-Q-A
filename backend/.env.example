# Databases (PostgreSQL)
USERS_DB_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5432/users_db
USERDATA_DB_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5432/userdata_db

# Security & Sessions
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<GENERATE_A_LONG_RANDOM_STRING>
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_NAME=access_token

# Chroma & Storage
CHROMA_PATH=../chromaDB
CHROMA_COLLECTION=myData
DATA_DIR=../data

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<YOUR_LLM_API_KEY>

# RAG & Retrieval
TOP_K=5
RERANK=true
RERANK_MODEL=jinaai/jina-reranker-v1-tiny-en
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CANDIDATES=30
HYBRID=true
KEYWORD_CANDIDATES=30
HISTORY_TURNS=6

# Application & Auth Settings
APP_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=true
VERIFY_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=60

# Email (SMTP) - Leave SMTP_HOST empty to write emails to backend/outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>
SMTP_FROM=RAG Q&A <no-reply@localhost>
SMTP_STARTTLS=true

